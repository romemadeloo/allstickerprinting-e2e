# Which servers to test. "production" (default) or "dev" (needs the three ASP_DEV_* URLs).
# Team rule DEC-007: prefer a dev server; production runs only read-only specs.
E2E_ENVIRONMENT=production

# Dev server URLs (ask the QA owner which server to use; none are registered yet).
ASP_DEV_BASE_URL=
ASP_DEV_API_URL=
ASP_DEV_ADMIN_URL=

# chromium-desktop (default) | firefox-desktop | webkit-desktop | chromium-mobile | all-desktop
E2E_BROWSER_PROJECT=chromium-desktop

# Parallel browsers. Keep low on production to stay under the WAF rate limit.
PW_WORKERS=2

# Opt in to specs that write data (add to cart). Always refused on production.
RUN_CART_E2E=false

# Optional member account on a dev server for signed-in specs. Missing = those specs skip.
ASP_MEMBER_EMAIL=
ASP_MEMBER_PASSWORD=

HEADED=false
